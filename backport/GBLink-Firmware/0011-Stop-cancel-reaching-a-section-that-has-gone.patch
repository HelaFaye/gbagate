diff --git a/src/module/link.cpp b/src/module/link.cpp
index 34eaa6d..6bfb9dc 100644
--- a/src/module/link.cpp
+++ b/src/module/link.cpp
@@ -18,10 +18,20 @@ void LinkModule::execute()
     {
         {
             UsbSection section(m_packetLayerMode);
+            // cancel() and receiveCommand() run on the host's thread and reach
+            // the section through this pointer, so it is set and cleared under
+            // irq_lock, and cleared before the section is destroyed. A Cancel
+            // that came while the section was being built cancels it now.
+            unsigned int key = irq_lock();
             m_currentSection = &section;
+            const bool cancelled = m_cancel;
+            irq_unlock(key);
+            if (cancelled) section.cancel();
             keepAlive = section.process();
+            key = irq_lock();
+            m_currentSection = nullptr;
+            irq_unlock(key);
         }
-        m_currentSection = nullptr; //kinda sketch but commands should only arrive when we have a current section
 
         if (keepAlive)
         {
@@ -47,11 +57,19 @@ void LinkModule::receiveCommand(std::span<const uint8_t> command)
         // 400 ms pause between sections; a host retrying at either moment
         // must not fault the adapter.
         case LinkModeCommand::StartHandshake:
+        {
+            const unsigned int key = irq_lock();   // the section stays while used
             if (UsbSection* s = m_currentSection) s->startHandshake();
+            irq_unlock(key);
             return;
+        }
         case LinkModeCommand::ConnectLink:
+        {
+            const unsigned int key = irq_lock();
             if (UsbSection* s = m_currentSection) s->connectLink();
+            irq_unlock(key);
             return;
+        }
         default: break;
     }
 }
