From 5230a24746f43a37dcdbf0a5cfdc44a9215d1cd1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 20:18:19 +0000
Subject: [PATCH 1/6] Zero-pad short link data packets instead of reading past
 them

usbLink_receiveHandler took subspan<0,16> .. subspan<48,16> of every data
packet. On a dynamic-extent span that is undefined for anything under 64
bytes, and in practice read whatever the endpoint (or the serial RX buffer)
held from the previous packet -- replaying stale commands at the GBA.
Hosts send whole 64-byte packets; a shorter one is now zero-padded, an
all-zero frame being the relay's 'nothing to send'.

Found by running this firmware under AddressSanitizer on a host
(global-buffer-overflow).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014LvpUYFw94JkaNFyrbwJmK
---
 src/callbacks/usbLinkCommand.cpp | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/callbacks/usbLinkCommand.cpp b/src/callbacks/usbLinkCommand.cpp
index 054df9b..0d0d47b 100644
--- a/src/callbacks/usbLinkCommand.cpp
+++ b/src/callbacks/usbLinkCommand.cpp
@@ -2,6 +2,8 @@
 #include "../link_defines.h"
 #include "zephyr/kernel.h"
 
+#include <cstring>
+
 static uint8_t g_index = 0;
 
 static uint16_t g_packet[8] = {};
@@ -14,10 +16,16 @@ K_MSGQ_DEFINE(g_packetQueue, 16, 200, 1);
 
 void usbLink_receiveHandler(std::span<const uint8_t> data, void*)
 {
-    k_msgq_put(&g_packetQueue, data.subspan<0, 16>().data(), K_NO_WAIT);
-    k_msgq_put(&g_packetQueue, data.subspan<16, 16>().data(), K_NO_WAIT);
-    k_msgq_put(&g_packetQueue, data.subspan<32, 16>().data(), K_NO_WAIT);
-    k_msgq_put(&g_packetQueue, data.subspan<48, 16>().data(), K_NO_WAIT);
+    // Hosts send whole 64-byte packets, but a shorter one must not be read
+    // past its end: subspan<48, 16>() on a dynamic-extent span is undefined
+    // for it, and in practice replays the previous packet's tail at the GBA.
+    // Zero-pad instead -- an all-zero frame is the relay's "nothing to send".
+    uint8_t packet[64] = {};
+    std::memcpy(packet, data.data(), data.size() < sizeof packet ? data.size() : sizeof packet);
+    k_msgq_put(&g_packetQueue, &packet[0], K_NO_WAIT);
+    k_msgq_put(&g_packetQueue, &packet[16], K_NO_WAIT);
+    k_msgq_put(&g_packetQueue, &packet[32], K_NO_WAIT);
+    k_msgq_put(&g_packetQueue, &packet[48], K_NO_WAIT);
 }
 
 static void loadTransivePacket()
