+import {describe, expect, test} from "vitest";
+import {Subject} from "rxjs";
+import {Session} from "../src/session.js";
+import {SessionManager} from "../src/sessionManager.js";
+import {CommandType, LinkStatus} from "../src/messages/gameboy.js";
+import {sessionCreatePlayers} from "../src/messages/validation.js";
+
+// A client as the session sees it: its emits are recorded and acked at once, and the test plays its events.
+class FakeClient {
+    sent: {event: string, data: any}[] = [];
+    sessionEvents: string[] = [];
+    private events = new Map<string, Subject<{data: unknown, ack?: (r: unknown) => void}>>();
+    private uuid = 0;
+
+    constructor(private clientId: string) {}
+
+    id() { return this.clientId; }
+    inSession(_: boolean) {}
+    emitSessionEvent(event: string) { this.sessionEvents.push(event); }
+    emitWithRetry(event: string, data?: any) {
+        this.sent.push({event, data});
+        return Promise.resolve(true);
+    }
+    fromEventWithAck(event: string) {
+        if (!this.events.has(event)) this.events.set(event, new Subject());
+        return this.events.get(event)!.asObservable();
+    }
+
+    play(event: string, data: unknown): unknown {
+        let acked: unknown;
+        this.events.get(event)?.next({data, ack: (r: unknown) => { acked = r; }});
+        return acked;
+    }
+    status(linkStatus: LinkStatus) { return this.play("deviceStatus", {uuid: this.clientId + "-" + this.uuid++, linkStatus}); }
+    data(sequence: number) { return this.play("deviceData", [{sequence, data: new Array(32).fill(sequence)}]); }
+
+    commands() { return this.sent.filter(s => s.event === "deviceCommand").map(s => s.data.command as CommandType); }
+    commandIds() { return this.sent.filter(s => s.event === "deviceCommand").map(s => s.data.id); }
+    packets() { return this.sent.filter(s => s.event === "deviceData").flatMap(s => s.data); }
+}
+
+const flush = () => new Promise(r => setTimeout(r, 0));
+
+function sessionOf(players: number, count = players) {
+    const session = new Session("1234", players);
+    const clients = Array.from({length: count}, (_, i) => new FakeClient("c" + i));
+    for (const c of clients) session.enter(c as any);
+    return {session, clients};
+}
+
+describe("sessionCreate options", () => {
+    test("nothing, null or no players field is a two-player session", () => {
+        expect(sessionCreatePlayers(undefined)).toBe(2);
+        expect(sessionCreatePlayers(null)).toBe(2);
+        expect(sessionCreatePlayers({})).toBe(2);
+    });
+    test("2 to 4 players", () => {
+        expect(sessionCreatePlayers({players: 3})).toBe(3);
+        expect(sessionCreatePlayers({players: 4})).toBe(4);
+    });
+    test("anything else is refused", () => {
+        for (const bad of [{players: 1}, {players: 5}, {players: 2.5}, {players: "4"}, [], "4", 4])
+            expect(sessionCreatePlayers(bad)).toBeUndefined();
+    });
+});
+
+describe("a two-player session is as before", () => {
+    test("the creator is told when the partner joins", () => {
+        const {clients} = sessionOf(2);
+        expect(clients[0].sessionEvents).toEqual(["partnerJoined"]);
+        expect(clients[1].sessionEvents).toEqual([]);
+    });
+    test("first ready master, the other slave, with no link IDs", async () => {
+        const {clients} = sessionOf(2);
+        clients[1].status(LinkStatus.AwaitMode);
+        clients[0].status(LinkStatus.AwaitMode);
+        await flush();
+        expect(clients.map(c => c.commands())).toEqual([[CommandType.SetModeSlave], [CommandType.SetModeMaster]]);
+        expect(clients.flatMap(c => c.commandIds())).toEqual([undefined, undefined]);
+    });
+    test("data goes to the partner unchanged, with no sender field", async () => {
+        const {clients} = sessionOf(2);
+        expect(clients[0].data(0)).toBe(true);
+        await flush();
+        expect(clients[1].packets()).toEqual([{sequence: 0, data: new Array(32).fill(0)}]);
+        expect(clients[0].packets()).toEqual([]);
+    });
+});
+
+describe("a four-player session", () => {
+    test("is full at four, and a fifth is refused", () => {
+        const manager = new SessionManager();
+        const creator = new FakeClient("c0");
+        const created = manager.createSession(creator as any, 4);
+        expect(created.isOk && created.value).toMatchObject({full: false, players: 4, slot: 0});
+        const id = created.isOk ? created.value.id : "";
+        for (let i = 1; i < 4; i++) {
+            const joined = manager.enterSession(new FakeClient("c" + i) as any, id);
+            expect(joined.isOk && joined.value).toMatchObject({full: i === 3, players: 4, slot: i});
+        }
+        const fifth = manager.enterSession(new FakeClient("c4") as any, id);
+        expect(fifth.isErr && fifth.error).toBe("Session is full");
+    });
+
+    test("tells the waiting players only once the last one has joined", () => {
+        const session = new Session("1234", 4);
+        const clients = Array.from({length: 4}, (_, i) => new FakeClient("c" + i));
+        for (const c of clients.slice(0, 3)) session.enter(c as any);
+        expect(clients.slice(0, 3).map(c => c.sessionEvents)).toEqual([[], [], []]);
+        session.enter(clients[3] as any);
+        expect(clients.map(c => c.sessionEvents)).toEqual([["partnerJoined"], ["partnerJoined"], ["partnerJoined"], []]);
+    });
+
+    test("one parent GBA (its board SetModeSlave), three children (SetModeMaster), each with its link ID", async () => {
+        const {clients} = sessionOf(4);
+        for (const i of [2, 0, 3, 1]) clients[i].status(LinkStatus.AwaitMode);
+        await flush();
+        expect(clients.map(c => c.commands())).toEqual([
+            [CommandType.SetModeMaster], [CommandType.SetModeMaster], [CommandType.SetModeSlave], [CommandType.SetModeMaster]]);
+        expect(clients.map(c => c.commandIds())).toEqual([[1], [3], [0], [2]]);
+        clients[2].data(0);                    // joined third, ready first: link ID 0
+        await flush();
+        for (const i of [0, 1, 3]) expect(clients[i].packets().map(p => p.from)).toEqual([0]);
+    });
+
+    test("a board asking again keeps its link ID", async () => {
+        const {clients} = sessionOf(4);
+        clients[1].status(LinkStatus.AwaitMode);
+        clients[0].status(LinkStatus.AwaitMode);
+        clients[1].status(LinkStatus.AwaitMode);
+        await flush();
+        expect(clients[1].commandIds()).toEqual([0, 0]);
+        expect(clients[0].commandIds()).toEqual([1]);
+    });
+
+    test("starts the handshake only when all four have one, and for all four", async () => {
+        const {clients} = sessionOf(4);
+        for (const c of clients.slice(0, 3)) c.status(LinkStatus.HandshakeReceived);
+        await flush();
+        expect(clients.flatMap(c => c.commands())).toEqual([]);
+        clients[3].status(LinkStatus.HandshakeReceived);
+        await flush();
+        expect(clients.map(c => c.commands())).toEqual(new Array(4).fill([CommandType.StartHandshake]));
+    });
+
+    test("does not start the handshake while the session is not full", async () => {
+        const {clients} = sessionOf(4, 2);
+        for (const c of clients) c.status(LinkStatus.HandshakeReceived);
+        await flush();
+        expect(clients.flatMap(c => c.commands())).toEqual([]);
+    });
+
+    test("a player's link connecting connects the other three", async () => {
+        const {clients} = sessionOf(4);
+        clients[0].status(LinkStatus.LinkConnected);
+        await flush();
+        expect(clients.map(c => c.commands())).toEqual([[], [CommandType.ConnectLink], [CommandType.ConnectLink], [CommandType.ConnectLink]]);
+    });
+
+    test("each player's data reaches the other three once, in order, saying whose it is", async () => {
+        const {clients} = sessionOf(4);
+        for (const c of clients) c.status(LinkStatus.AwaitMode);   // link IDs 0-3, in this order
+        for (let seq = 0; seq < 3; seq++) {
+            clients[2].data(seq);
+            clients[2].data(seq);              // a retry: dropped
+        }
