diff --git a/src/messages/validation.ts b/src/messages/validation.ts
index 24c0a8d..dd8723a 100644
--- a/src/messages/validation.ts
+++ b/src/messages/validation.ts
@@ -28,6 +28,52 @@ export function isSessionId(value: unknown): value is string {
     return typeof value === "string" && /^\d{4}$/.test(value);
 }
 
+export const MIN_PLAYERS = 2;
+export const MAX_PLAYERS = 4;
+
+/** How many GBAs a client brings: one, or up to three on one board's cable. */
+function gbasOf(value: Record<string, unknown>): number | undefined {
+    if (value.gbas === undefined) return 1;
+    const gbas = value.gbas;
+    if (!Number.isInteger(gbas) || (gbas as number) < 1 || (gbas as number) > MAX_PLAYERS - 1) return undefined;
+    return gbas as number;
+}
+
+/**
+ * The options a client may pass with sessionCreate: {players: 2..4, gbas: 1..3}. `players` counts GBAs, the
+ * link's units; `gbas` is how many of them this client brings (one board with up to three on its cable). Older
+ * clients pass nothing (or null): two players, one GBA each. Returns undefined if the options are invalid.
+ */
+export function sessionCreateOptions(value: unknown): { players: number, gbas: number } | undefined {
+    if (value === undefined || value === null) return { players: MIN_PLAYERS, gbas: 1 };
+    if (!isRecord(value)) return undefined;
+    let players = MIN_PLAYERS;
+    if (value.players !== undefined) {
+        if (!Number.isInteger(value.players) || (value.players as number) < MIN_PLAYERS
+            || (value.players as number) > MAX_PLAYERS) return undefined;
+        players = value.players as number;
+    }
+    const gbas = gbasOf(value);
+    if (gbas === undefined || gbas >= players) return undefined;   // someone else must be able to join
+    return { players, gbas };
+}
+
+/** The players a session is created for (sessionCreateOptions without the GBAs). */
+export function sessionCreatePlayers(value: unknown): number | undefined {
+    return sessionCreateOptions(value)?.players;
+}
+
+/**
+ * What a client may pass with sessionJoin: the session's id, as clients always have, or {id, gbas} from a client
+ * bringing several GBAs. Returns undefined if it is invalid.
+ */
+export function sessionJoinRequest(value: unknown): { id: string, gbas: number } | undefined {
+    if (isSessionId(value)) return { id: value, gbas: 1 };
+    if (!isRecord(value) || !isSessionId(value.id)) return undefined;
+    const gbas = gbasOf(value);
+    return gbas === undefined ? undefined : { id: value.id, gbas };
+}
+
 export function isClientId(value: unknown): value is string {
     return typeof value === "string" && value.length > 0 && value.length <= 64;
 }
