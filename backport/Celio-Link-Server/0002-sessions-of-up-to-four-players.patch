+describe("a board bringing several GBAs", () => {
+    test("create and join take how many GBAs a client brings", () => {
+        expect(sessionCreateOptions({players: 4, gbas: 3})).toEqual({players: 4, gbas: 3});
+        expect(sessionCreateOptions({players: 4})).toEqual({players: 4, gbas: 1});
+        expect(sessionCreateOptions(null)).toEqual({players: 2, gbas: 1});
+        expect(sessionJoinRequest("1234")).toEqual({id: "1234", gbas: 1});
+        expect(sessionJoinRequest({id: "1234", gbas: 2})).toEqual({id: "1234", gbas: 2});
+    });
+    test("a creator must leave room for someone else, and bad counts are refused", () => {
+        for (const bad of [{players: 4, gbas: 4}, {players: 2, gbas: 2}, {players: 4, gbas: 0}, {players: 4, gbas: 1.5}, {players: 4, gbas: "2"}])
+            expect(sessionCreateOptions(bad)).toBeUndefined();
+        for (const bad of [{id: "1234", gbas: 4}, {id: "12", gbas: 1}, {gbas: 1}, 1234])
+            expect(sessionJoinRequest(bad)).toBeUndefined();
+    });
+
+    function boards(...gbas: number[]) {
+        const session = new Session("1234", gbas.reduce((a, b) => a + b, 0));
+        const clients = gbas.map((_, i) => new FakeClient("b" + i));
+        clients.forEach((c, i) => session.enter(c as any, gbas[i]));
+        return {session, clients};
+    }
+
+    test("the session is full when the GBAs fill it, not the clients", () => {
+        const session = new Session("1234", 4);
+        session.enter(new FakeClient("a") as any, 3);
+        expect(session.isFull()).toBe(false);
+        expect(session.hasRoomFor(2)).toBe(false);
+        expect(session.hasRoomFor(1)).toBe(true);
+        session.enter(new FakeClient("b") as any, 1);
+        expect(session.isFull()).toBe(true);
+    });
+
+    test("the manager refuses a join with more GBAs than there is room for", () => {
+        const m = new SessionManager();
+        const a = new FakeClient("a"), b = new FakeClient("b"), c = new FakeClient("c");
+        const made = m.createSession(a as any, 4, 2);
+        expect(made.isOk && made.value.gbas).toBe(2);
+        const id = made.isOk ? made.value.id : "";
+        expect(m.enterSession(b as any, id, 3).isErr).toBe(true);
+        const joined = m.enterSession(c as any, id, 2);
+        expect(joined.isOk && joined.value.full).toBe(true);
+    });
+
+    test("each board's link ID is the first of its slots: 3 + 1", async () => {
+        const {clients} = boards(3, 1);
+        clients[0].status(LinkStatus.AwaitMode);
+        clients[1].status(LinkStatus.AwaitMode);
+        await flush();
+        expect(clients[0].commands()).toEqual([CommandType.SetModeSlave]);   // its GBA on port 1 is the parent
+        expect(clients[0].commandIds()).toEqual([0]);
+        expect(clients[1].commands()).toEqual([CommandType.SetModeMaster]);
+        expect(clients[1].commandIds()).toEqual([3]);
+    });
+
+    test("1 + 2 + 1, the two-GBA board ready first", async () => {
+        const {clients} = boards(1, 2, 1);
+        for (const i of [1, 0, 2]) clients[i].status(LinkStatus.AwaitMode);
+        await flush();
+        expect(clients.map(c => c.commandIds())).toEqual([[2], [0], [3]]);
+        expect(clients.map(c => c.commands()[0])).toEqual([CommandType.SetModeMaster, CommandType.SetModeSlave, CommandType.SetModeMaster]);
+    });
+
+    test("data is marked with the sender's first slot", async () => {
+        const {clients} = boards(3, 1);
+        clients[0].status(LinkStatus.AwaitMode);
+        clients[1].status(LinkStatus.AwaitMode);
+        clients[1].data(0);
+        clients[0].data(0);
+        await flush();
+        expect(clients[0].packets().map(p => p.from)).toEqual([3]);
+        expect(clients[1].packets().map(p => p.from)).toEqual([0]);
+    });
+
+    test("the handshake waits for every board, then goes to all", async () => {
+        const {clients} = boards(3, 1);
+        for (const c of clients) c.status(LinkStatus.AwaitMode);
+        clients[0].status(LinkStatus.HandshakeReceived);
+        await flush();
+        expect(clients[0].commands()).not.toContain(CommandType.StartHandshake);
+        clients[1].status(LinkStatus.HandshakeReceived);
+        await flush();
+        for (const c of clients) expect(c.commands()).toContain(CommandType.StartHandshake);
+    });
+});
