@@ -28,6 +28,22 @@ export function isSessionId(value: unknown): value is string {
     return typeof value === "string" && /^\d{4}$/.test(value);
 }
 
+export const MIN_PLAYERS = 2;
+export const MAX_PLAYERS = 4;
+
+/**
+ * The options a client may pass with sessionCreate. Older clients pass nothing (or null): a two-player session.
+ * Returns the player count, or undefined if the options are invalid.
+ */
+export function sessionCreatePlayers(value: unknown): number | undefined {
+    if (value === undefined || value === null) return MIN_PLAYERS;
+    if (!isRecord(value)) return undefined;
+    if (value.players === undefined) return MIN_PLAYERS;
+    const players = value.players;
+    if (!Number.isInteger(players) || (players as number) < MIN_PLAYERS || (players as number) > MAX_PLAYERS) return undefined;
+    return players as number;
+}
+
 export function isClientId(value: unknown): value is string {
     return typeof value === "string" && value.length > 0 && value.length <= 64;
 }
