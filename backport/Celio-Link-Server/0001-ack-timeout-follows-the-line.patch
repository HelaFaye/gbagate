     emitWithRetry<R>(event: string, data?: any, {
         retries = 5,
         timeout = 1000,
-        backoff = 100  // ms added per retry
     } = {}) {
+        // Each copy waits twice as long as the last (1, 2, 4, 8, 8, 8 s from a 1 s start), and every
+        // copy listens for its ack until the last one's time is up: on a line slower than the wait,
+        // the first copy's ack still arrives, and counts. Only an ack for the first copy is timed (Karn).
+        const base = this.ackTimeoutMs(timeout);
+        const waits = Array.from({length: retries + 1}, (_, i) => Math.min(8000, base * 2 ** i));
+        const deadline = Date.now() + waits.reduce((a, b) => a + b, 0);
         return new Promise((resolve, reject) => {
-            let attempt = 0;
+            let attempt = 0, settled = false, timer: ReturnType<typeof setTimeout> | undefined;
 
